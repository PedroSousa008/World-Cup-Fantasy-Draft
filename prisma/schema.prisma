// Prisma schema for World Cup Fantasy Draft
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  USER
}

enum PlayerPosition {
  GK
  DEF
  MID
  FWD
}

enum PlayerAvailability {
  AVAILABLE
  INJURED
  SUSPENDED
  ELIMINATED
}

enum TeamStatus {
  QUALIFIED
  ELIMINATED
  ACTIVE
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
}

enum BetStatus {
  PENDING
  ACCEPTED
  LIVE
  WON
  LOST
  CANCELLED
  DISPUTED
}

enum BetType {
  MATCH
  PLAYER
  FANTASY
  CUSTOM
}

enum StakeType {
  POINTS
  MONEY
  DRINKS
  DINNER
  CUSTOM_PUNISHMENT
  CUSTOM_REWARD
}

enum CalendarEventType {
  MATCHDAY
  DRAFT
  REDRAFT
  BETTING_DEADLINE
  PREDICTION_DEADLINE
  CUSTOM
}

enum CompletionStatus {
  PENDING
  COMPLETED
}

enum PowerType {
  DOUBLE_POINTS
  TRIPLE_CAPTAIN
  RIVAL_CHALLENGE
  LUCKY_DIP
  WILDCARD
  CURSE
}

enum PowerStatus {
  PENDING
  ACTIVE
  USED
  EXPIRED
}

enum RivalChallengeStatus {
  AWAITING_ACCEPTANCE
  PENDING
  ACTIVE
  USED
  DECLINED
  EXPIRED
}

// ─── Platform & Auth ─────────────────────────────────────────────────────────

/// Singleton platform configuration. Only one row should ever exist.
model PlatformSettings {
  id             String   @id @default("platform")
  ownerCreated   Boolean  @default(false)
  ownerId        String?  @unique
  owner          User?    @relation("PlatformOwner", fields: [ownerId], references: [id])
  bettingEnabled Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   DateTime?
  passwordHash    String
  username        String    @unique
  teamName        String
  selectedNation  String
  profilePicture  String?
  role            UserRole  @default(USER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Auth.js relations
  accounts Account[]
  sessions Session[]

  // Platform owner relation
  ownedPlatform PlatformSettings? @relation("PlatformOwner")

  // User activity relations (Phase 2+)
  createdBets     Bet[]        @relation("BetCreator")
  opponentBets    Bet[]        @relation("BetOpponent")
  predictions     Prediction[]
  fantasyTeam     FantasyTeam?
  calendarEvents  CalendarEvent[] @relation("EventCreator")
  savedPlayers       SavedPlayer[]
  powerUsages        UserPower[]
  powerNotifications PowerNotification[]
  rivalChallengesSent     RivalChallenge[] @relation("RivalChallenger")
  rivalChallengesReceived RivalChallenge[] @relation("RivalOpponent")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Tournament Data (Owner-managed) ─────────────────────────────────────────

model NationalTeam {
  id         String     @id @default(cuid())
  name       String     @unique
  slug       String     @unique
  code       String     @unique
  flagEmoji  String?
  flagUrl    String?
  imageDir   String
  isActive   Boolean    @default(true)
  groupName  String?
  status     TeamStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  players       Player[]
  homeMatches   Match[]  @relation("HomeTeam")
  awayMatches   Match[]  @relation("AwayTeam")
}

model Player {
  id               String             @id @default(cuid())
  name             String
  photoUrl         String?
  position         PlayerPosition
  positionLocked   Boolean            @default(true)
  nationality      String
  club             String?
  availability     PlayerAvailability @default(AVAILABLE)
  teamStatus       TeamStatus         @default(ACTIVE)
  nationalTeamId   String?
  nationalTeam     NationalTeam?      @relation(fields: [nationalTeamId], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  fantasySlots FantasyTeamPlayer[]
  matchEvents  MatchEvent[]
  savedBy      SavedPlayer[]

  @@index([nationalTeamId])
  @@index([position])
}

model Match {
  id           String      @id @default(cuid())
  homeTeamId   String
  awayTeamId   String
  homeTeam     NationalTeam @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam     NationalTeam @relation("AwayTeam", fields: [awayTeamId], references: [id])
  scheduledAt  DateTime
  matchday     Int?
  status       MatchStatus @default(SCHEDULED)
  homeScore    Int?
  awayScore    Int?
  manOfTheMatchId String?
  bettingOpen  Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  events MatchEvent[]
  bets   Bet[]
}

model MatchEvent {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId  String?
  player    Player?  @relation(fields: [playerId], references: [id])
  eventType String
  minute    Int?
  createdAt DateTime @default(now())
}

model ScoringRule {
  id        String   @id @default(cuid())
  ruleKey   String   @unique
  label     String
  points    Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Fantasy Teams ───────────────────────────────────────────────────────────

model FantasyTeam {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  captainId     String?
  viceCaptainId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  players FantasyTeamPlayer[]
}

model FantasyTeamPlayer {
  id            String      @id @default(cuid())
  fantasyTeamId String
  fantasyTeam   FantasyTeam @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)
  playerId      String
  player        Player      @relation(fields: [playerId], references: [id])
  isStarter     Boolean     @default(true)
  slotOrder     Int         @default(0)
  createdAt     DateTime    @default(now())

  @@unique([fantasyTeamId, playerId])
}

// ─── Saved Players (user shortlist) ──────────────────────────────────────────

model SavedPlayer {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, playerId])
  @@index([userId])
}

// ─── Predictions ─────────────────────────────────────────────────────────────

model Prediction {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       String
  predictionType String
  value          String
  matchId        String?
  points         Float    @default(0)
  isSettled      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, category])
}

// ─── Betting ─────────────────────────────────────────────────────────────────

model Bet {
  id          String    @id @default(cuid())
  creatorId   String
  creator     User      @relation("BetCreator", fields: [creatorId], references: [id])
  opponentId  String?
  opponent    User?     @relation("BetOpponent", fields: [opponentId], references: [id])
  matchId     String?
  match       Match?    @relation(fields: [matchId], references: [id])
  betType     BetType
  stakeType   StakeType
  stakeValue  String
  description String
  status      BetStatus @default(PENDING)
  isPromoted  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([creatorId, status])
  @@index([opponentId, status])
}

model BetAnnouncement {
  id        String   @id @default(cuid())
  title     String
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Rewards & Punishments ───────────────────────────────────────────────────

model Reward {
  id           String           @id @default(cuid())
  title        String
  description  String?
  rankPosition Int?
  status       CompletionStatus @default(PENDING)
  assignedToId String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Punishment {
  id           String           @id @default(cuid())
  title        String
  description  String?
  rankPosition Int?
  status       CompletionStatus @default(PENDING)
  assignedToId String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

// ─── Calendar ────────────────────────────────────────────────────────────────

model CalendarEvent {
  id          String            @id @default(cuid())
  title       String
  description String?
  eventType   CalendarEventType
  startsAt    DateTime
  endsAt      DateTime?
  createdById String?
  createdBy   User?             @relation("EventCreator", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([startsAt])
}

// ─── Powers ────────────────────────────────────────────────────────────────────

model UserPower {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  powerType       PowerType
  status          PowerStatus
  matchday        Int?
  targetPlayerId  String?
  targetUserId    String?
  rivalChallengeId String?    @unique
  rivalChallenge  RivalChallenge? @relation(fields: [rivalChallengeId], references: [id])
  pointsEffect    Int?
  resultSummary   String?
  activatedAt     DateTime    @default(now())
  settledAt       DateTime?
  updatedAt       DateTime    @updatedAt

  wildcardTransfers WildcardTransfer[]

  @@unique([userId, powerType])
  @@index([userId, status])
  @@index([matchday])
}

model RivalChallenge {
  id                    String               @id @default(cuid())
  challengerId          String
  challenger            User                 @relation("RivalChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponentId            String
  opponent              User                 @relation("RivalOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  matchday              Int
  status                RivalChallengeStatus @default(AWAITING_ACCEPTANCE)
  challengerMdPoints    Int?
  opponentMdPoints      Int?
  challengerFinalPoints Int?
  opponentFinalPoints   Int?
  winnerId              String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  userPowers UserPower[]

  @@index([opponentId, status])
  @@index([challengerId])
}

model PowerNotification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model WildcardTransfer {
  id          String    @id @default(cuid())
  userPowerId String
  userPower   UserPower @relation(fields: [userPowerId], references: [id], onDelete: Cascade)
  playerOutId String?
  playerInId  String
  createdAt   DateTime  @default(now())
}
